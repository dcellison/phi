  "groups": {
    "part1_first_light": {
      "motif": "first_light",
      "title": "First light",
      "summary": "Begin with the question that made Phi necessary. Its first sounds and sentences end in a conversation."
    },
    "part2_soul": {
      "motif": "living_heart",
      "title": "The soul of Phi",
      "summary": "The five pillars lead into Phi's sound, its social life, and its way of learning."
    },
    "part3_phonology": {
      "motif": "spoken_sound",
      "title": "Phonology",
      "summary": "Nineteen sounds become words through open syllables, vowel hiatus, and penultimate stress. Romanization and Tengwar give them two written forms."
    },
    "part4_grammar": {
      "motif": "ordered_layers",
      "title": "Grammar",
      "summary": "This is the working machinery. Particles and word order set the frame; the later chapters fill it with nouns, numbers, time, voice, and claimed sources."
    },
    "part5_complex": {
      "motif": "woven_thoughts",
      "title": "Complex structures",
      "summary": "Coordination leads into discourse, subordinate clauses, and relative clauses. Simple sentences learn to travel together."
    },
    "part6_mastery": {
      "motif": "lived_practice",
      "title": "Mastery",
      "summary": "Courtesy and social context open the part. Transmutation, daily practice, and exact source material bring the grammar into use."
    },
    "part7_reference": {
      "motif": "open_reference",
      "title": "Reference",
      "summary": "Here the grammar, compounds, module guides, and sample texts sit within reach."
    },
    "appendices": {
      "motif": "indexed_notes",
      "title": "Appendices",
      "summary": "The appendices collect linguistic terms, comparisons with natural languages, and paths for further study."
    },
    "colophon": {
      "motif": "makers_mark",
      "title": "Colophon",
      "summary": "The maker signs the book and explains how Phi's human decisions and AI-assisted workshop fit together."
    }
  },
